# Copy to .env next to docker-compose.yml and fill in. Never commit the filled
# copy -- .gitignore already excludes .env.

# The domain pointing at this server. Caddy issues the certificate for exactly
# this name, and the frontend is BUILT against it, so changing it later means
# rebuilding the frontend image, not just restarting it.
SIJILL_DOMAIN=sijill.example.com

# --- Database ------------------------------------------------------------
# These create the Postgres role on first start. Pick a long random password;
# it never leaves the server.
PGDATABASE=sijill
DATABASE_USERNAME=sijill
DATABASE_PASSWORD=

# --- Auth ----------------------------------------------------------------
# Any long random string. Changing it invalidates every issued token, which
# logs everyone out -- fine to do, just do it deliberately.
# Generate with: openssl rand -base64 48
JWT_SIGNING_SECRET=

# --- MinIO (object storage on this machine) ------------------------------
# Credentials for the local MinIO. Set before first start: like Postgres, the
# root user is created once and changing these later does not rename it.
# Generate with: openssl rand -hex 24
MINIO_ROOT_USER=sijill
MINIO_ROOT_PASSWORD=

# --- Object storage ------------------------------------------------------
# During the move these still hold the Supabase values; README step 8 swaps
# them to MinIO after the objects are mirrored and the stored URLs rewritten.
#
# On MinIO they become:
#   OBJECT_STORAGE_ENDPOINT=http://minio:9000
#   OBJECT_STORAGE_PUBLIC_URL_BASE=https://<your domain>/files
#   OBJECT_STORAGE_ACCESS_KEY=<MINIO_ROOT_USER>
#   OBJECT_STORAGE_SECRET_KEY=<MINIO_ROOT_PASSWORD>
# Bucket names stay exactly as they are -- that is what keeps every stored
# object key valid.
# Copy these verbatim from the Render dashboard. The attachment URLs already
# stored in the database point at this bucket, so it must not change during
# the move.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_BACKUP_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_URL_BASE=

# --- Optional ------------------------------------------------------------
TRANSLATION_HELPER_ENABLED=false
TRANSLATION_PROVIDER=anthropic
TRANSLATION_API_KEY=
# Internal URL used by the short name/label auto-translate buttons.
NAME_TRANSLATION_BASE_URL=http://sijill-translator:5000
BACKUP_RETENTION_DAYS=30
