# Copy to .env and fill in locally. Never commit the real .env file.

# --- Database ---
DATABASE_URL=jdbc:postgresql://localhost:5432/sijill
DATABASE_USERNAME=sijill
DATABASE_PASSWORD=

# --- JWT ---
JWT_SIGNING_SECRET=
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=14

# --- Object storage (S3-compatible; MinIO locally, provider TBD in prod — see decision record item #3) ---
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=sijill-local
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_QR_BASE_URL=http://localhost:3000/public/assets

# --- Translation helper (disabled by default — see decision record item #10) ---
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=
TRANSLATION_HELPER_ENABLED=false

# --- Backups ---
BACKUP_STORAGE_LOCATION=
BACKUP_RETENTION_DAYS=30

# --- Misc ---
SPRING_PROFILES_ACTIVE=local
