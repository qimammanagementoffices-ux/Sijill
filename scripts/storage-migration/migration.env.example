# Copy this file to .env.migration.local and fill it locally.
# .env.migration.local is ignored by Git. Never commit these credentials.

OBJECT_STORAGE_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
OBJECT_STORAGE_REGION=<your-project-region>
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

STORAGE_MIGRATION_SOURCE_BUCKET=sijill-app
OBJECT_STORAGE_BUCKET=sijill-public
OBJECT_STORAGE_BACKUP_BUCKET=sijill-private
